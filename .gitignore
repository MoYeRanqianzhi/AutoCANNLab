# 凭证与运行时状态（含 token，严禁入库）
.agents/secrets/
.agents/runtime.local.json

# 运行产物
logs/
__pycache__/
*.pyc
.venv/

# 调查临时产物
.agents/tmp/
.playwright-mcp/
*.png

# 前端依赖、静态构建和浏览器验收产物
web/node_modules/
web/dist/
web/*.tsbuildinfo
output/playwright/
.playwright-cli/
.worktrees/
.agents/**/*.local.*
.agents/*.local.*

# 运行时数据（含 GitCode token 与 API 令牌，严禁入库）
.agents/data/
autocannlab.egg-info/
